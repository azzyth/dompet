# Copy to .env and fill in. NEVER commit the real .env.

# --- Postgres -----------------------------------------------------------------
# Local docker-compose value (see docker-compose.yml)
DATABASE_URL=postgresql://dompet:dompet@localhost:5432/dompet

# Hosted alternative (Neon / Supabase free tier), e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/dompet?sslmode=require

# --- Ingestion: IMAP inbox ----------------------------------------------------
# A dedicated inbox you forward bank / e-wallet notifications to.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_SEARCH=UNSEEN

# --- Ingest webhook (for the optional Android notification forwarder) ---------
INGEST_TOKEN=change-me
